{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RedTeamFinding",
  "type": "object",
  "properties": {
    "id": { "type": "string", "example": "VULN-001" },
    "type": { 
      "type": "string", 
      "enum": ["IDOR", "SQLI", "XSS", "FILE_UPLOAD", "BROKEN_AUTH"] 
    },
    "endpoint": { "type": "string", "example": "/api/transactions/42" },
    "http_method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "description": { "type": "string" },
    "reproduction": {
      "type": "object",
      "properties": {
        "headers": { "type": "object" },
        "payload": { "type": "object" },
        "url_params": { "type": "object" },
        "test_user": { "type": "string" }
      },
      "required": ["headers"]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "status_code": { "type": "integer" },
        "response_body": { "type": "string" },
        "extracted_data": { "type": "string" }
      },
      "required": ["status_code", "response_body"]
    },
    "timestamp": { "type": "string" }
  },
  "required": ["id", "type", "endpoint", "http_method", "severity", "description", "reproduction", "evidence"]
}
