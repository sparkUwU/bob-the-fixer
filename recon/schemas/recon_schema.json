{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recon attack surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_info", "endpoints", "auth_surface", "data_flows"],
  "properties": {
    "app_info": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "tech_stack", "database"],
      "properties": {"name": {"type": "string"}, "tech_stack": {"type": "array", "items": {"type": "string"}}, "database": {"type": "string"}}
    },
    "endpoints": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "method", "auth_required", "roles_allowed", "parameters", "source_file"],
        "properties": {
          "id": {"type": "string", "pattern": "^EP-[0-9]{3,}$"}, "path": {"type": "string"},
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "ANY"]},
          "auth_required": {"type": "boolean"}, "roles_allowed": {"type": "array", "items": {"type": "string"}},
          "parameters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "location", "type"], "properties": {"name": {"type": "string"}, "location": {"type": "string", "enum": ["path", "query", "body", "header", "unknown"]}, "type": {"type": "string"}}}},
          "source_file": {"type": "string"}
        }
      }
    },
    "auth_surface": {
      "type": "object", "additionalProperties": false,
      "required": ["login_endpoint", "auth_type", "header"],
      "properties": {"login_endpoint": {"type": ["string", "null"]}, "auth_type": {"type": "string"}, "header": {"type": ["string", "null"]}}
    },
    "data_flows": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["flow_id", "source", "sink", "file", "sensitive"],
        "properties": {"flow_id": {"type": "string", "pattern": "^DF-[0-9]{3,}$"}, "source": {"type": "string"}, "sink": {"type": "string"}, "file": {"type": "string"}, "sensitive": {"type": "boolean"}}
      }
    }
  }
}
